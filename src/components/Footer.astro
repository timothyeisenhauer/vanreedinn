---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#2A1C0E] border-t border-[#D4A574]/20 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-4 gap-8 mb-8">
      <!-- Brand -->
      <div class="md:col-span-2">
        <h3 class="font-display text-3xl text-gold-gradient mb-4">VAN REED INN</h3>
        <p class="text-[#F5F0E8]/60 mb-4 max-w-md">
          Best wings in Berks County. Smoked then fried to perfection. 
          Your neighborhood spot for great food, cold beer, and good times.
        </p>
        <div class="flex gap-4">
          <a 
            href="https://g.page/r/Cd4cQR7Q1x9_EAE/review" 
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-[#3D2914] rounded-full flex items-center justify-center text-[#D4A574] hover:bg-[#D4622A] hover:text-white transition-all"
            aria-label="Google Reviews"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.545,10.239v3.821h5.445c-0.712,2.315-2.647,3.972-5.445,3.972c-3.332,0-6.033-2.701-6.033-6.032s2.701-6.032,6.033-6.032c1.498,0,2.866,0.549,3.921,1.453l2.814-2.814C17.503,2.988,15.139,2,12.545,2C7.021,2,2.543,6.477,2.543,12s4.478,10,10.002,10c8.396,0,10.249-7.85,9.426-11.748L12.545,10.239z"/>
            </svg>
          </a>
          <a 
            href="https://www.facebook.com/VanReedInn/" 
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-[#3D2914] rounded-full flex items-center justify-center text-[#D4A574] hover:bg-[#D4622A] hover:text-white transition-all"
            aria-label="Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Quick Links -->
      <div>
        <h4 class="font-display text-lg text-[#D4A574] mb-4">Quick Links</h4>
        <ul class="space-y-2">
          <li><a href="#wings" class="text-[#F5F0E8]/60 hover:text-[#D4A574] transition-colors">Our Wings</a></li>
          <li><a href="#menu" class="text-[#F5F0E8]/60 hover:text-[#D4A574] transition-colors">Menu</a></li>
          <li><a href="#visit" class="text-[#F5F0E8]/60 hover:text-[#D4A574] transition-colors">Hours & Location</a></li>
          <li><a href="#reviews" class="text-[#F5F0E8]/60 hover:text-[#D4A574] transition-colors">Reviews</a></li>
        </ul>
      </div>
      
      <!-- Contact -->
      <div>
        <h4 class="font-display text-lg text-[#D4A574] mb-4">Contact</h4>
        <ul class="space-y-2 text-[#F5F0E8]/60">
          <li class="flex items-center gap-2">
            <span>📞</span>
            <a href="tel:+14845094418" class="hover:text-[#D4A574] transition-colors">(484) 509-4418</a>
          </li>
          <li class="flex items-start gap-2">
            <span>📍</span>
            <address class="not-italic">
              2707 Bernville Rd<br/>
              Reading, PA 19605
            </address>
          </li>
        </ul>
      </div>
    </div>
    
    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-[#D4A574]/10 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-[#F5F0E8]/40 text-sm">
        © {currentYear} The Van Reed Inn. All rights reserved.
      </p>
      <p class="text-[#F5F0E8]/40 text-sm">
        Must be 21+ to consume alcohol. Please drink responsibly.
      </p>
    </div>
  </div>
</footer>