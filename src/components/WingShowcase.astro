---
import { Image } from 'astro:assets';
import wingsBaskets from '../assets/images/wings-baskets.jpg';
import wingsBuffaloBasket from '../assets/images/wings-buffalo-basket.jpg';
import wingsGarlicParm from '../assets/images/wings-garlic-parm.jpg';
import wingsCrispyFried from '../assets/images/wings-crispy-fried.jpg';
import wingsTakeout from '../assets/images/wings-takeout.jpg';
import wingsSauced from '../assets/images/wings-sauced.jpg';
import wingsWhiteDrizzle from '../assets/images/wings-white-drizzle.jpg';
import wingsBeer from '../assets/images/wings-beer.jpg';

const premiumFlavors = [
  { name: "Spicy Garlic", desc: "The local legend", img: wingsBuffaloBasket },
  { name: "Garlic Parmesan", desc: "Rich & savory", img: wingsGarlicParm },
  { name: "Lemon Pepper Dry Rub", desc: "Zesty, no mess", img: wingsCrispyFried },
  { name: "Honey Tequila Mustard", desc: "Sweet with a kick", img: wingsTakeout },
  { name: "Honey Tequila BBQ", desc: "Smoky & sticky", img: wingsSauced },
  { name: "Pineapple BBQ", desc: "Sweet heat, island style", img: wingsWhiteDrizzle },
];

const wingGallery = [
  { src: wingsBuffaloBasket, alt: "Basket of our saucy buffalo wings" },
  { src: wingsWhiteDrizzle, alt: "Smoked wings finished with garlic parm drizzle" },
  { src: wingsCrispyFried, alt: "Crispy golden wings straight from the fryer" },
  { src: wingsBeer, alt: "Wings and a cold beer at the bar" },
];
---

<section id="wings" class="py-20 md:py-32 bg-[#3D2914]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="text-[#D4622A] font-semibold uppercase tracking-wider text-sm">Our Claim to Fame</span>
      <h2 class="font-display text-4xl md:text-6xl text-gold-gradient mt-2 mb-4">
        LEGENDARY WINGS
      </h2>
      <p class="text-[#F5F0E8]/70 text-lg max-w-2xl mx-auto">
        Jumbo wings smoked in-house, then deep fried to crispy perfection.
        19 signature sauces plus 6 premium flavors — 25 ways to get messy.
      </p>
    </div>

    <!-- Wing Process -->
    <div class="grid md:grid-cols-3 gap-8 mb-16">
      <div class="text-center group">
        <div class="w-20 h-20 mx-auto mb-4 bg-[#2A1C0E] rounded-full flex items-center justify-center border-2 border-[#D4622A]/30 group-hover:border-[#D4622A] transition-colors">
          <span class="text-3xl" aria-hidden="true">🔥</span>
        </div>
        <h3 class="font-display text-3xl md:text-4xl text-[#D4A574] mb-2">SMOKED</h3>
        <p class="text-[#F5F0E8]/60">Slow-smoked in-house for deep, real barbecue flavor</p>
      </div>
      <div class="text-center group">
        <div class="w-20 h-20 mx-auto mb-4 bg-[#2A1C0E] rounded-full flex items-center justify-center border-2 border-[#D4622A]/30 group-hover:border-[#D4622A] transition-colors">
          <span class="text-3xl" aria-hidden="true">⚡</span>
        </div>
        <h3 class="font-display text-3xl md:text-4xl text-[#D4A574] mb-2">FRIED</h3>
        <p class="text-[#F5F0E8]/60">Deep fried to order for the ultimate crispy skin</p>
      </div>
      <div class="text-center group">
        <div class="w-20 h-20 mx-auto mb-4 bg-[#2A1C0E] rounded-full flex items-center justify-center border-2 border-[#D4622A]/30 group-hover:border-[#D4622A] transition-colors">
          <span class="text-3xl" aria-hidden="true">💧</span>
        </div>
        <h3 class="font-display text-3xl md:text-4xl text-[#D4A574] mb-2">SAUCED</h3>
        <p class="text-[#F5F0E8]/60">Tossed while hot in your choice of 25 sauces & flavors</p>
      </div>
    </div>

    <!-- Wings Photo Banner -->
    <div class="rounded-2xl overflow-hidden mb-4 border border-[#D4A574]/20">
      <Image
        src={wingsBaskets}
        alt="Baskets of our smoked-then-fried wings"
        widths={[768, 1280, 1920]}
        sizes="(min-width: 1280px) 1216px, 100vw"
        format="webp"
        quality={80}
        class="w-full h-auto img-zoom"
      />
    </div>

    <!-- Wing Gallery -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
      {wingGallery.map(photo => (
        <div class="aspect-square rounded-xl overflow-hidden border border-[#D4A574]/10">
          <Image
            src={photo.src}
            alt={photo.alt}
            widths={[320, 640]}
            sizes="(min-width: 768px) 25vw, 50vw"
            format="webp"
            quality={80}
            class="w-full h-full object-cover img-zoom"
          />
        </div>
      ))}
    </div>

    <!-- Premium Flavor Grid -->
    <div class="bg-[#2A1C0E] rounded-2xl p-8 md:p-12 border border-[#D4A574]/20">
      <h3 class="font-display text-3xl text-center text-[#E8C9A0] mb-2">PREMIUM FLAVORS</h3>
      <p class="text-center text-[#F5F0E8]/50 mb-8 text-sm">Add $1.00 per 5 wings — worth every penny</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {premiumFlavors.map(flavor => (
          <div class="flex items-center gap-4 p-4 bg-[#3D2914] rounded-lg hover:bg-[#3D2914]/80 transition-colors group">
            <div class="w-14 h-14 rounded-full overflow-hidden flex-shrink-0 border-2 border-[#D4622A]/40 group-hover:border-[#D4622A] transition-colors">
              <Image
                src={flavor.img}
                alt=""
                width={112}
                height={112}
                format="webp"
                quality={80}
                class="w-full h-full object-cover"
              />
            </div>
            <div class="flex-1">
              <h4 class="font-display text-xl text-[#F5F0E8] group-hover:text-[#D4A574] transition-colors">
                {flavor.name}
              </h4>
              <p class="text-[#F5F0E8]/50 text-sm">{flavor.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="text-center text-[#F5F0E8]/50 mt-6 text-sm">
        Plus 19 classic sauces from Hot to Old Bay — see the full list in <a href="#menu" class="text-[#D4A574] hover:text-[#E8C9A0] underline underline-offset-2 transition-colors">the menu</a>
      </p>
    </div>

    <!-- Awards/Recognition -->
    <div class="mt-16 grid md:grid-cols-3 gap-8 text-center">
      <div class="p-6 border border-[#D4A574]/20 rounded-xl">
        <div class="text-5xl mb-3" aria-hidden="true">🏆</div>
        <h4 class="font-display text-2xl md:text-3xl text-[#D4A574]">Award-Winning Wings</h4>
        <p class="text-[#F5F0E8]/70 text-base md:text-lg mt-2">And award-winning smoked chili to match</p>
      </div>
      <div class="p-6 border border-[#D4A574]/20 rounded-xl">
        <div class="text-5xl mb-3" aria-hidden="true">⭐</div>
        <h4 class="font-display text-2xl md:text-3xl text-[#D4A574]">4.3 Stars on Google</h4>
        <p class="text-[#F5F0E8]/70 text-base md:text-lg mt-2">488 Google reviews and counting</p>
      </div>
      <div class="p-6 border border-[#D4A574]/20 rounded-xl">
        <div class="text-5xl mb-3" aria-hidden="true">🍺</div>
        <h4 class="font-display text-2xl md:text-3xl text-[#D4A574]">Perfect Pairing</h4>
        <p class="text-[#F5F0E8]/70 text-base md:text-lg mt-2">Cold drafts at the bar & 6-packs to go</p>
      </div>
    </div>
  </div>
</section>
