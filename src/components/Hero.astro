---
---

<section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-gradient-to-b from-[#2A1C0E]/80 via-[#2A1C0E]/60 to-[#2A1C0E]/90 z-10"></div>
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=1920&q=80')] bg-cover bg-center"></div>
  </div>
  
  <!-- Animated Smoke Effect -->
  <div class="absolute inset-0 z-5 pointer-events-none overflow-hidden">
    <div class="smoke-particle absolute bottom-1/4 left-1/4 w-32 h-32 bg-white/10 rounded-full blur-3xl" style="animation-delay: 0s;"></div>
    <div class="smoke-particle absolute bottom-1/3 left-1/3 w-24 h-24 bg-white/5 rounded-full blur-2xl" style="animation-delay: 0.5s;"></div>
    <div class="smoke-particle absolute bottom-1/4 right-1/3 w-40 h-40 bg-white/8 rounded-full blur-3xl" style="animation-delay: 1s;"></div>
  </div>
  
  <!-- Content -->
  <div class="relative z-20 text-center px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto pt-20">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 bg-[#D4622A]/20 border border-[#D4622A]/40 rounded-full px-4 py-2 mb-6 animate-float">
      <span class="text-[#D4622A] text-lg">🔥</span>
      <span class="text-[#E8C9A0] text-sm font-semibold uppercase tracking-wider">Smoked Then Fried to Perfection</span>
    </div>
    
    <!-- Main Headline -->
    <h1 class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-gold-gradient mb-6 leading-none">
      BEST WINGS<br/>
      <span class="text-[#F5F0E8]">IN BERKS COUNTY</span>
    </h1>
    
    <!-- Subheadline -->
    <p class="text-lg sm:text-xl md:text-2xl text-[#F5F0E8]/80 max-w-2xl mx-auto mb-8 font-light">
      The Van Reed Inn — Where locals gather for legendary wings, cold beer, 
      and good times since 1969
    </p>
    
    <!-- Rating -->
    <div class="flex items-center justify-center gap-4 mb-10">
      <div class="flex items-center gap-1">
        {[...Array(5)].map(() => (
          <svg class="w-6 h-6 text-[#D4A574]" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
        <span class="ml-2 text-[#F5F0E8] font-semibold">4.3</span>
      </div>
      <span class="text-[#F5F0E8]/60">|</span>
      <span class="text-[#F5F0E8]/80">488 Google Reviews</span>
    </div>
    
    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a 
        href="#visit" 
        class="bg-[#D4622A] hover:bg-[#B83232] text-white px-8 py-4 rounded-lg text-lg font-bold uppercase tracking-wider transition-all duration-300 fire-glow"
      >
        Visit Us Today
      </a>
      <a 
        href="#menu" 
        class="bg-transparent border-2 border-[#D4A574] text-[#D4A574] hover:bg-[#D4A574] hover:text-[#2A1C0E] px-8 py-4 rounded-lg text-lg font-bold uppercase tracking-wider transition-all duration-300"
      >
        View Menu
      </a>
    </div>
    
    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-[#D4A574]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </div>
</section>