---
const hours = [
  { day: "Monday", time: "11:00 AM - 2:00 AM" },
  { day: "Tuesday", time: "11:00 AM - 2:00 AM" },
  { day: "Wednesday", time: "11:00 AM - 2:00 AM" },
  { day: "Thursday", time: "11:00 AM - 2:00 AM" },
  { day: "Friday", time: "11:00 AM - 2:00 AM" },
  { day: "Saturday", time: "11:00 AM - 2:00 AM" },
  { day: "Sunday", time: "11:00 AM - 12:00 AM" },
];
---

<section id="visit" class="py-20 md:py-32 bg-[#3D2914]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="text-[#D4622A] font-semibold uppercase tracking-wider text-sm">Come See Us</span>
      <h2 class="font-display text-4xl md:text-6xl text-gold-gradient mt-2 mb-4">
        VISIT THE VAN REED INN
      </h2>
      <p class="text-[#F5F0E8]/70 text-lg">
        2707 Bernville Rd, Reading, PA 19605 — Just outside Leesport
      </p>
    </div>
    
    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <!-- Info Card -->
      <div class="space-y-8">
        <!-- Hours -->
        <div class="bg-[#2A1C0E] rounded-2xl p-8 border border-[#D4A574]/20">
          <h3 class="font-display text-2xl text-[#D4A574] mb-6 flex items-center gap-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            HOURS
          </h3>
          <div class="space-y-3">
            {hours.map(({ day, time }) => (
              <div class="flex justify-between items-center py-2 border-b border-[#D4A574]/10 last:border-0">
                <span class="text-[#F5F0E8]/80">{day}</span>
                <span class="text-[#E8C9A0] font-medium">{time}</span>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Contact -->
        <div class="bg-[#2A1C0E] rounded-2xl p-8 border border-[#D4A574]/20">
          <h3 class="font-display text-2xl text-[#D4A574] mb-6 flex items-center gap-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            CONTACT
          </h3>
          <div class="space-y-4">
            <a 
              href="tel:+14845094418" 
              class="flex items-center gap-3 text-[#F5F0E8] hover:text-[#D4A574] transition-colors"
            >
              <span class="text-2xl">📞</span>
              <span class="text-xl font-semibold">(484) 509-4418</span>
            </a>
            <div class="flex items-start gap-3 text-[#F5F0E8]/70">
              <span class="text-2xl">📍</span>
              <address class="not-italic">
                2707 Bernville Rd<br/>
                Reading, PA 19605
              </address>
            </div>
          </div>
        </div>
        
        <!-- Quick CTA -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a 
            href="https://maps.google.com/?q=The+Van+Reed+Inn+2707+Bernville+Rd+Reading+PA" 
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 bg-[#D4622A] hover:bg-[#B83232] text-white text-center px-6 py-4 rounded-lg font-bold uppercase tracking-wider transition-all duration-300 fire-glow"
          >
            Get Directions
          </a>
          <a 
            href="tel:+14845094418" 
            class="flex-1 bg-transparent border-2 border-[#D4A574] text-[#D4A574] hover:bg-[#D4A574] hover:text-[#2A1C0E] text-center px-6 py-4 rounded-lg font-bold uppercase tracking-wider transition-all duration-300"
          >
            Call Now
          </a>
        </div>
      </div>
      
      <!-- Map Placeholder -->
      <div class="h-full min-h-[400px] bg-[#2A1C0E] rounded-2xl overflow-hidden border border-[#D4A574]/20">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3040.4197296017424!2d-75.9906257!3d40.3876616!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c6767f1c339293%3A0x73c5cda8ffb59540!2sThe%20Van%20Reed%20Inn!5e0!3m2!1sen!2sus!4v1704067200000!5m2!1sen!2sus"
          width="100%" 
          height="100%" 
          style="border:0; min-height: 500px;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
          class="grayscale-[30%] hover:grayscale-0 transition-all duration-500"
        ></iframe>
      </div>
    </div>
  </div>
</section>