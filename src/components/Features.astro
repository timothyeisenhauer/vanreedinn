---
const features = [
  {
    icon: "🎰",
    title: "Skill Games",
    description: "Try your luck on our selection of skill games and Pennsylvania skill machines"
  },
  {
    icon: "🎱",
    title: "Pool Table",
    description: "Grab a cue and challenge your friends to a game on our full-size pool table"
  },
  {
    icon: "🎯",
    title: "Darts",
    description: "Test your aim with our dart boards — perfect for friendly competition"
  },
  {
    icon: "🍺",
    title: "Cold Beer To Go",
    description: "Takeout beer available — grab a 6-pack or case on your way home"
  },
  {
    icon: "📺",
    title: "Sports on TV",
    description: "Catch the game on our screens with cold drinks and great company"
  },
  {
    icon: "🤝",
    title: "Local Vibe",
    description: "A true neighborhood dive where everybody knows your name"
  }
];
---

<section id="features" class="py-20 md:py-32 bg-[#2A1C0E] relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23D4A574\' fill-opacity=\'0.4\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
  </div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="text-[#D4622A] font-semibold uppercase tracking-wider text-sm">More Than Just Wings</span>
      <h2 class="font-display text-4xl md:text-6xl text-gold-gradient mt-2 mb-4">
        COME HANG OUT
      </h2>
      <p class="text-[#F5F0E8]/70 text-lg max-w-2xl mx-auto">
        The Van Reed Inn is your neighborhood spot for good food, cold drinks, 
        and entertainment. Pull up a stool and stay awhile.
      </p>
    </div>
    
    <!-- Features Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map(feature => (
        <div class="group p-6 bg-[#3D2914] rounded-xl border border-[#D4A574]/10 hover:border-[#D4A574]/30 transition-all duration-300 hover:-translate-y-1">
          <div class="w-14 h-14 bg-[#D4622A]/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-[#D4622A]/20 transition-colors">
            <span class="text-3xl">{feature.icon}</span>
          </div>
          <h3 class="font-display text-2xl text-[#E8C9A0] mb-2">{feature.title}</h3>
          <p class="text-[#F5F0E8]/60 leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
    
    <!-- Photo Gallery Preview -->
    <div class="mt-20">
      <h3 class="font-display text-3xl text-center text-[#E8C9A0] mb-8">THE VIBE</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="aspect-square rounded-lg overflow-hidden">
          <img
            src="/images/dining-room.jpg"
            alt="Our bright dining room, ready for lunch"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover img-zoom"
          />
        </div>
        <div class="aspect-square rounded-lg overflow-hidden">
          <img
            src="/images/margarita.jpg"
            alt="Fresh margarita on the bar"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover img-zoom"
          />
        </div>
        <div class="aspect-square rounded-lg overflow-hidden">
          <img
            src="/images/burger-pickles.jpg"
            alt="Cheeseburger with pickles and fresh-cut fries"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover img-zoom"
          />
        </div>
        <div class="aspect-square rounded-lg overflow-hidden">
          <img
            src="/images/burger-platter-fries.jpg"
            alt="Burger and fries platter on the table"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover img-zoom"
          />
        </div>
      </div>
    </div>
  </div>
</section>