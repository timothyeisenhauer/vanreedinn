---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "The Van Reed Inn | Best Wings in Berks County",
  description = "The Van Reed Inn — award-winning wings smoked in-house then deep fried, with 25 sauces & flavors. Neighborhood bar with pool, skill games, cold beer & 6-packs to go. 2707 Bernville Rd, Reading, PA."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content="best wings Berks County, best wings Reading PA, Van Reed Inn, smoked wings, dive bar, skill games, pool, takeout beer, Leesport PA, chicken wings" />
  <link rel="canonical" href="https://vanreedinn.com/" />
  <meta name="theme-color" content="#2A1C0E" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="restaurant.restaurant" />
  <meta property="og:url" content="https://vanreedinn.com" />
  <meta property="og:site_name" content="The Van Reed Inn" />
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <title>{title}</title>
  
  <!-- Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Restaurant",
      "name": "The Van Reed Inn",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "2707 Bernville Rd",
        "addressLocality": "Reading",
        "addressRegion": "PA",
        "postalCode": "19605",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 40.3876616,
        "longitude": -75.9906257
      },
      "url": "https://vanreedinn.com",
      "telephone": "+14845094418",
      "priceRange": "$$",
      "servesCuisine": ["American", "Wings", "Barbecue", "Bar Food"],
      "menu": "https://vanreedinn.com/#menu",
      "openingHours": [
        "Mo-Su 11:00-02:00"
      ],
      "sameAs": [
        "https://www.instagram.com/vanreedinn/",
        "https://www.facebook.com/p/The-Van-Reed-Inn-61563311820288/"
      ]
    }
  </script>
</head>
<body class="bg-[#2A1C0E] text-[#F5F0E8] antialiased">
  <slot />
</body>
</html>