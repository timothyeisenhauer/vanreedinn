---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "The Van Reed Inn | Best Wings in Berks County", 
  description = "The Van Reed Inn - Famous for the best wings in Berks County. Smoked then fried to perfection. Local dive bar with skill games, pool, cold beer & takeout. 2707 Bernville Rd, Reading, PA."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content="best wings Berks County, best wings Reading PA, Van Reed Inn, smoked wings, dive bar, skill games, pool, takeout beer, Leesport PA, chicken wings" />
  
  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="restaurant" />
  <meta property="og:url" content="https://vanreedinn.com" />
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <title>{title}</title>
  
  <!-- Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Restaurant",
      "name": "The Van Reed Inn",
      "image": "https://lh5.googleusercontent.com/p/AF1QipOe_sample_image=w1200",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "2707 Bernville Rd",
        "addressLocality": "Reading",
        "addressRegion": "PA",
        "postalCode": "19605",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 40.3876616,
        "longitude": -75.9906257
      },
      "url": "https://vanreedinn.com",
      "telephone": "+14845094418",
      "priceRange": "$",
      "servesCuisine": ["American", "Wings", "Bar Food"],
      "openingHours": [
        "Mo-Sa 11:00-02:00",
        "Su 11:00-00:00"
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.3",
        "reviewCount": "488"
      }
    }
  </script>
</head>
<body class="bg-[#2A1C0E] text-[#F5F0E8] antialiased">
  <slot />
</body>
</html>